# Without nix-direnv, stock direnv re-runs `nix print-dev-env` on every
# new shell session; nix-direnv caches the environment and GC-roots it.
if ! has nix_direnv_version || ! nix_direnv_version 3.1.2; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.2/direnvrc" "sha256-Di03ad3a0ueGi6CGrfhrQzyGdQIg9APXIPCAMNQgWYM="
fi
source_env_if_exists .envrc.private
# Use the template's default shell until init-dev-shell creates this user's
# module. Explicit PROFILE selections remain strict so typos still fail.
dev_shell="${USER}${PROFILE:+.${PROFILE}}"
if [[ -z "${PROFILE:-}" && ! -f "nix/devShells/${USER}.nix" && ! -f "nix/devShells/${USER}/default.nix" ]]; then
  dev_shell=default
fi
# Sibling checkouts sharing this flake should share one nix-direnv cache; see
# "Sibling checkouts sharing one flake" in the nix-chips README.
use flake ".#${dev_shell}"
